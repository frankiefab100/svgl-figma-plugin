{
  "name": "svgl-logos-for-figma",
  "version": "1.0.0",
  "private": true,
  "description": "Search, preview, and import vector logos from SVGL into your Figma designs",
  "keywords": [
    "logos",
    "svg",
    "brand assets",
    "vector logos",
    "design icons",
    "svgl"
  ],
  "author": "@frankiefab100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankiefab100/svgl-figma-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/frankiefab100/svgl-figma-plugin/issues"
  },
  "homepage": "https://github.com/frankiefab100/svgl-figma-plugin#readme",
  "scripts": {
    "build:ui": "vite build --config vite.config.ts",
    "build:code": "vite build --config vite.plugin.config.ts",
    "build": "npm run build:ui && npm run build:code",
    "dev": "npm run build -- --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.125.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
